RUSTFS_ACCESS_KEY=tu_clave_de_acceso_segura
RUSTFS_SECRET_KEY=tu_clave_secreta_muy_segura

# Direcciones internas: deben coincidir con los puertos de Compose.
RUSTFS_ADDRESS=:9000
RUSTFS_CONSOLE_ADDRESS=:9001
RUSTFS_CONSOLE_ENABLE=true
RUSTFS_OBS_LOGGER_LEVEL=error
RUSTFS_OBS_LOG_DIRECTORY=/var/log/rustfs/
