# --- PostgreSQL local de desarrollo (perfil "localdb") ---
# Copiar a Postgres/.env. Estas credenciales son solo para la base local.
POSTGRES_DB=repositorio
POSTGRES_USER=repositorio
POSTGRES_PASSWORD=change-me

# --- Origen de la copia (perfil "localdb-sync") ---
# Mismos valores que DATABASE_* de la base remota (Neon) en Backend/.env.
# Solo se usan para leer con pg_dump; la base remota no se modifica.
REMOTE_DATABASE_HOST=your-managed-postgres-host
REMOTE_DATABASE_PORT=5432
REMOTE_DATABASE_NAME=your-database
REMOTE_DATABASE_USER=your-user
REMOTE_DATABASE_PASSWORD=change-me
REMOTE_DATABASE_SSLMODE=require
