NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://backend:8000

# Nombres de las cookies de sesión y CSRF. Deben coincidir exactamente con
# SESSION_COOKIE_NAME y CSRF_COOKIE_NAME del backend. Se incorporan en `next build`.
# Desarrollo HTTP:
NEXT_PUBLIC_SESSION_COOKIE_NAME=sessionid
NEXT_PUBLIC_CSRF_COOKIE_NAME=csrftoken
# Producción HTTPS:
# NEXT_PUBLIC_SESSION_COOKIE_NAME=__Host-sessionid
# NEXT_PUBLIC_CSRF_COOKIE_NAME=__Host-csrftoken

# Runtime. 1 en producción HTTPS: cookies Secure, HSTS y upgrade-insecure-requests.
SECURE_DEPLOYMENT=0
# 1 sólo si el balanceador de confianza elimina y reescribe X-Forwarded-Proto.
TRUST_FORWARDED_PROTO=0
# 1 para emitir la CSP como Content-Security-Policy-Report-Only durante pruebas.
CSP_REPORT_ONLY=0
# Orígenes adicionales permitidos en img-src (separados por espacios). Debe
# incluir el S3_PUBLIC_ENDPOINT del backend cuando no es HTTPS, porque la CSP
# sólo admite imágenes https: además del propio sitio y la API. En el
# docker-compose local (RustFS por HTTP en el puerto 9000):
CSP_IMG_SRC=http://localhost:9000
# Opcionales: endpoint de reportes y orígenes adicionales para connect-src.
# CSP_REPORT_URI=https://reportes.example.org/csp
# CSP_CONNECT_SRC=
