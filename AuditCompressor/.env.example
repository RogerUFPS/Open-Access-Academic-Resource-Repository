# Copiar a AuditCompressor/.env. Nunca versionar valores reales.
# Los nombres DATABASE_* y S3_* coinciden con los de Backend/.env.example.

# --- Servicio ---
# Clave server-to-server que usará el Backend (header X-API-Key).
# Nunca entregarla al Frontend. Sin valor, los endpoints protegidos responden 503.
AUDIT_COMPRESSOR_API_KEY=

# --- PostgreSQL (aún no se usa) ---
# Dentro de Docker Compose el host es el servicio "postgres" en el puerto 5432.
# Recomendado: un usuario de solo lectura sobre la tabla de auditoría.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSLMODE=disable

# --- RustFS / S3 (aún no se usa) ---
# Mismo servicio RustFS del proyecto; usar un bucket PRIVADO distinto de
# "imagenes", que tiene descarga anónima.
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Protección de snapshots (aún no se usa) ---
# Formato y longitud pendientes de definir junto con el mecanismo de cifrado.
AUDIT_ENCRYPTION_KEY=
