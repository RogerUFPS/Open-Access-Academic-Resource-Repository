# Copiar a AuditCompressor/.env. Nunca versionar valores reales.
# Los nombres DATABASE_* y S3_* coinciden con los de Backend/.env.example.

# --- Servicio ---
# Clave server-to-server que usará el Backend (header X-API-Key).
# Nunca entregarla al Frontend. Sin valor, los endpoints protegidos responden 503.
AUDIT_COMPRESSOR_API_KEY=

# --- PostgreSQL ---
# DuckDB se conecta en modo READ_ONLY. Dentro de Docker Compose el host es el
# servicio "postgres" en el puerto 5432.
# Recomendado: un usuario de solo lectura sobre la tabla de auditoría.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# --- RustFS / S3 ---
# Mismo servicio RustFS del proyecto. "auditorias" lo crea rustfs-init sin
# acceso anónimo; no usar "imagenes", que tiene descarga pública.
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET=auditorias
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Cifrado de snapshots ---
# Obligatoria para archivar y para leer snapshots cifrados. 32 bytes en base64:
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Si se pierde o se cambia, los snapshots cifrados con ella dejan de poder leerse.
AUDIT_ENCRYPTION_KEY=
