      "api_key_env": "GLM_VLLM_API_KEY",
      "deployment": {
        "enable_auto_tool_choice": true,
        "tool_call_parser": "hermes"
      },
      "request_options": {}
    },
    {
      "name": "llama",
      "aliases": ["llama3.1:8b", "biblioteca-llama3.1-8b"],
