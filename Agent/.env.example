# Seleccione exactamente un archivo de modelo para API y vLLM.
MODEL_ENV_FILE=deploy/models/qwen.env

# API privada del agente: el público utiliza Backend/api/agent/chat/.
AGENT_API_KEY=replace-with-a-long-random-secret
AGENT_PORT=8001
AGENT_INSTANCE=qwen
AGENT_MAX_CONCURRENCY=4
AGENT_CONCURRENCY_WAIT_SECONDS=1.0

# stable mantiene el flujo anterior. facets es experimental y NO superó
# la evaluación semántica con los modelos actuales; no activar en producción.
AGENT_CLASSIFICATION_MODE=stable

# Contrato de inferencia y uso de GPU.
AGENT_VLLM_BASE_URL=http://vllm:8000/v1
AGENT_VLLM_API_KEY=local-compose
HF_HOME=/root/.cache/huggingface
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=8
VLLM_REQUEST_TIMEOUT_SECONDS=300
VLLM_MAX_TOKENS=384

# Requerido solo para modelos privados o con licencia, como Llama.
HF_TOKEN=

# Índice RAG generado al iniciar. Ruta escribible dentro del contenedor.
AUTO_INDEX_RAG=true
RAG_DB_PATH=/tmp/biblioteca/rag.sqlite3

# El backend sincroniza el catálogo real por hash. Para ejecución aislada,
# configurar explícitamente un archivo real o la URL del snapshot del Backend.
AGENT_CATALOG_SNAPSHOT=
AGENT_BACKEND_SNAPSHOT_URL=
AGENT_BACKEND_CACHE_TTL=300
