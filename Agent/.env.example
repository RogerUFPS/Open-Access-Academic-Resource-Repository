# API pública del agente
AGENT_API_KEY=replace-with-a-long-random-secret
PORT=8000
PORT_HEALTH=8000
HEALTH_CHECK_PATH=/ping
AGENT_MAX_CONCURRENCY=8
AGENT_CONCURRENCY_WAIT_SECONDS=1.0
AGENT_MODEL_REGISTRY=/app/config/models.json

# Endpoints vLLM OpenAI-compatible desplegados por separado en RunPod.
QWEN_VLLM_BASE_URL=https://api.runpod.ai/v2/REPLACE_QWEN_ENDPOINT/openai/v1
QWEN_VLLM_API_KEY=replace-with-runpod-api-key
GLM_VLLM_BASE_URL=https://api.runpod.ai/v2/REPLACE_GLM_ENDPOINT/openai/v1
GLM_VLLM_API_KEY=replace-with-runpod-api-key
LLAMA_VLLM_BASE_URL=https://api.runpod.ai/v2/REPLACE_LLAMA_ENDPOINT/openai/v1
LLAMA_VLLM_API_KEY=replace-with-runpod-api-key

VLLM_REQUEST_TIMEOUT_SECONDS=300
VLLM_MAX_TOKENS=384
AUTO_INDEX_RAG=true

# Catálogo público de Biblioteca. Para RunPod use una URL HTTPS alcanzable.
AGENT_BACKEND_SNAPSHOT_URL=
AGENT_BACKEND_CACHE_TTL=300

# Solo para pruebas aisladas, ruta dentro del contenedor.
AGENT_CATALOG_SNAPSHOT=
