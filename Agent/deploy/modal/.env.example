# Solo para pruebas cloud. Cargar también deploy/models/<modelo>.env.
# Orden de preferencia; se asigna UNA GPU, no las tres simultáneamente.
# Para limitar más el costo: L4,A10 (o solo L4).
MODAL_GPU=L4,A10,L40S
# Secret de Modal con HF_TOKEN autorizado, si el checkpoint lo requiere.
MODAL_HF_SECRET=
