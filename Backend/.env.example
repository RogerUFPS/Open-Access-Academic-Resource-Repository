# --- Django ---
SECRET_KEY=change-me
DJANGO_DEBUG=0

# --- Base de datos ---
DATABASE_HOST=your-managed-postgres-host
DATABASE_PORT=5432
DATABASE_NAME=your-database
DATABASE_USER=your-user
DATABASE_PASSWORD=change-me
# Pool de conexiones del servicio web. docker-compose activa DATABASE_POOL=1
# solo en "backend"; worker y beat no lo usan. Conexiones máximas hacia la base:
# WEB_CONCURRENCY x DATABASE_POOL_MAX_SIZE (+ conexiones de Celery).
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=4
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_MAX_IDLE=300

# Para usar PostgreSQL local (perfil localdb) ver Postgres/README.md.

# --- Sesiones ---
# Segundos mínimos entre renovaciones de la expiración por inactividad (15 min).
# 0 = renovar en cada petición (comportamiento anterior).
SESSION_RENEWAL_INTERVAL=60
# Ventanas para inscripción MFA y reautenticación de operaciones críticas.
MFA_ENROLLMENT_TTL=600
RECENT_AUTH_AGE=300
# Cantidad de proxies confiables delante de Django para identificar la IP.
NUM_PROXIES=1

# En producción HTTPS, habilitar todo el perfil y usar cookies __Host-.
# El proxy DEBE eliminar X-Forwarded-Proto del cliente y escribir el suyo.
SECURE_DEPLOYMENT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
SESSION_COOKIE_NAME=sessionid
CSRF_COOKIE_NAME=csrftoken

# --- Hosts y CORS ---
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOW=0
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://backend:8000

# --- Email  ---
RESEND_API_KEY=change-me
DEFAULT_FROM_EMAIL=noreply@example.com
# Set once for initial bootstrap. The database lock makes concurrent starts safe.
SUPERADMIN_EMAIL=admin@example.com

# --- Celery / RabbitMQ ---
CELERY_BROKER_URL=amqp://your-rabbitmq-user:change-me@rabbitmq:5672//


# --- Celery Beat scheduler ---
SCHEDULER_API_URL=http://backend:8000
# Configure a random deployment secret and a non-superadmin user with check_link permission.
SCHEDULER_API_TOKEN=change-me
SCHEDULER_SERVICE_USER_ID=replace-with-service-user-id

# --- Almacenamiento S3 (RustFS) ---
# Endpoint interno usado por el backend dentro de Docker.
S3_ENDPOINT=http://rustfs:9000
# Endpoint público usado para construir las URLs de las imágenes.
# Debe ser accesible desde el navegador y no requiere expiración.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=imagenes
S3_REGION=us-east-1
RUSTFS_ACCESS_KEY=change-me
RUSTFS_SECRET_KEY=change-me
S3_MAX_IMAGE_SIZE=5242880
S3_ALLOWED_IMAGE_CONTENT_TYPES=image/jpeg,image/png,image/gif,image/webp


# --- Monitoreo automático de enlaces ---

# Cantidad de enlaces procesados por cada lote/task.
LINK_CHECK_BATCH_SIZE=50

# URL del Frontend usada en el botón/enlace del correo:
# "Revisar enlaces afectados".
#
# En desarrollo:
LINK_FAILURE_FRONTEND_URL=http://localhost:3000/admin/alertas

# En producción reemplazar por la URL real, por ejemplo:
# LINK_FAILURE_FRONTEND_URL=https://tu-dominio.com/admin/alertas

# --- Gunicorn ---
WEB_CONCURRENCY=2
